{
  "compilerOptions": {
    "target": "esnext",
    "types": ["node"],
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "removeComments": false,
    "paths": {
      "@root/*": ["./src/*"],
      "@rules/*": ["./rules/*"]
    }
  },
  "include": ["src", "script", "vite.config.ts"]
}
