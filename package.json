{
  "name": "@gondola-lyrics/kit",
  "version": "0.1.0",
  "description": "Gondola lyrics toolkit",
  "keywords": [
    "gondola",
    "lyrics",
    "lyric",
    "karaoke",
    "parser",
    "generator"
  ],
  "license": "MIT",
  "author": "folltoshe",
  "homepage": "https://github.com/gondola-lyrics/kit-node#readme",
  "bugs": {
    "url": "https://github.com/gondola-lyrics/kit-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gondola-lyrics/kit-node.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "build-change-log": "tsx script/build-change-log.ts",
    "bump-version": "tsx script/bump-version.ts",
    "release": "tsx script/release.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "default": "./dist/generator.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@gondola-lyrics/model": "^1.1.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@gondola-lyrics/model": "1.1.0",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/node": "26.4.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0"
  }
}
